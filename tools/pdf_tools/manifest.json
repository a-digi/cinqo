{
  "slug": "pdf_tools",
  "name": "PDF Tools",
  "version": "0.0.113",
  "mcp": true,
  "scopes": [
    {
      "scope": "tool:pdf_tools:convert",
      "description": "Convert a PDF document into Markdown text."
    },
    {
      "scope": "tool:pdf_tools:generate",
      "description": "Render XHTML into a PDF."
    },
    {
      "scope": "tool:pdf_tools:read",
      "description": "Fetch a previously generated PDF."
    }
  ],
  "routes": [
    {
      "method": "POST",
      "path_suffix": "convert-to-markdown",
      "required_scope": "tool:pdf_tools:convert"
    },
    {
      "method": "POST",
      "path_suffix": "generate",
      "required_scope": "tool:pdf_tools:generate"
    },
    {
      "method": "GET",
      "path_suffix": "files",
      "required_scope": "tool:pdf_tools:read"
    }
  ],
  "mcp_tools": [
    {
      "name": "pdf_to_markdown",
      "required_scope": "tool:pdf_tools:convert",
      "media_param": "url"
    },
    {
      "name": "generate_pdf",
      "required_scope": "tool:pdf_tools:generate"
    }
  ]
}