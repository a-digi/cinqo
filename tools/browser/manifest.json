    }
  ],
  "mcp_tools": [
    {
      "name": "fetch_page_html",
      "required_scope": "tool:browser:crawl"
    },
    {
      "name": "find_login_elements",
      "required_scope": "tool:browser:crawl"
    },
    {
      "name": "extract_page_data",
      "required_scope": "tool:browser:crawl"
    },
    {
      "name": "crawl_paginated",
      "required_scope": "tool:browser:crawl"
    },
    {
      "name": "extract_from_url",
      "required_scope": "tool:browser:crawl"
    },
    {
      "name": "find_repeating_items",
      "required_scope": "tool:browser:crawl"
    }
  ],
  "widgets": [
    {
      "key": "status",
      "title": "Browser",
      "description": "Whether Chrome is available for crawling.",
      "kind": "stat",
      "data_path": "dashboard/status",
      "width": 1,
      "height": 1,
      "refresh_seconds": 60
    }
  ]
}