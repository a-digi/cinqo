{
  "slug": "browser",
  "name": "Browser",
  "version": "0.0.131",
  "mcp": true,
  "scopes": [
    {
      "scope": "tool:browser:crawl",
      "description": "Navigate the shared browser session and read page content/structure — no credentials submitted."
    },
    {
      "scope": "tool:browser:login",
      "description": "Fill and submit a login form in the shared browser session."
    },
    {
      "scope": "tool:browser:login:status",
      "description": "Check whether a stored login credential exists for a domain (yes/no only) — no credential or username data returned."
    }
  ],
  "routes": [
    {
      "method": "POST",
      "path_suffix": "crawl",
      "required_scope": "tool:browser:crawl"
    },
    {
      "method": "POST",
      "path_suffix": "find-login-elements",
      "required_scope": "tool:browser:crawl"
    },
    {
      "method": "POST",
      "path_suffix": "extract",
      "required_scope": "tool:browser:crawl"
    },
    {
      "method": "POST",
      "path_suffix": "login",
      "required_scope": "tool:browser:login"
    },
    {
      "method": "GET",
      "path_suffix": "login-credentials",
      "required_scope": "tool:browser:login"
    },
    {
      "method": "POST",
      "path_suffix": "login-credentials",
      "required_scope": "tool:browser:login"
    },
    {
      "method": "DELETE",
      "path_suffix": "login-credentials",
      "required_scope": "tool:browser:login"
    },
    {
      "method": "POST",
      "path_suffix": "has-login-credential",
      "required_scope": "tool:browser:login:status"
    },
    {
      "method": "POST",
      "path_suffix": "crawl-paginated",
      "required_scope": "tool:browser:crawl"
    },
    {
      "method": "GET",
      "path_suffix": "crawl-logs",
      "required_scope": "tool:browser:crawl"
    },
    {
      "method": "DELETE",
      "path_suffix": "crawl-logs",
      "required_scope": "tool:browser:crawl"
    },
    {
      "method": "GET",
      "path_suffix": "browser-settings",
      "required_scope": "tool:browser:crawl"
    },
    {
      "method": "PUT",
      "path_suffix": "browser-settings",
      "required_scope": "tool:browser:crawl"
    },
    {
      "method": "GET",
      "path_suffix": "cloudflare-domains",
      "required_scope": "tool:browser:crawl"
    },
    {
      "method": "GET",
      "path_suffix": "crawl-status",
      "required_scope": "tool:browser:crawl"
    }
  ],
  "mcp_tools": [
    {
      "name": "fetch_page_html",
      "required_scope": "tool:browser:crawl"
    },
    {
      "name": "find_login_elements",
      "required_scope": "tool:browser:crawl"
    },
    {
      "name": "extract_page_data",
      "required_scope": "tool:browser:crawl"
    },
    {
      "name": "has_login_credential",
      "required_scope": "tool:browser:login:status"
    },
    {
      "name": "login",
      "required_scope": "tool:browser:login"
    },
    {
      "name": "crawl_paginated",
      "required_scope": "tool:browser:crawl"
    }
  ]
}