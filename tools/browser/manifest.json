{
  "slug": "browser",
  "name": "Browser",
  "version": "0.0.198",
  "mcp": true,
  "scopes": [
    {
      "scope": "tool:browser:crawl",
      "description": "Navigate the shared browser session and read page content/structure — no credentials submitted."
    },
    {
      "scope": "tool:browser:login",
      "description": "Fill and submit a login form in the shared browser session."
    },
    {
      "scope": "tool:browser:login:status",
      "description": "Check whether a stored login credential exists for a domain (yes/no only) — no credential or username data returned."
    }
  ],
  "routes": [
