{
  "slug": "browser",
  "name": "Browser",
  "version": "0.0.252",
  "description": "Opens and reads web pages for the other tools with Chrome; shows a window when a site asks you to prove you are human.",
  "authors": [
    { "name": "Anes Detit", "email": "tafa.andet@googlemail.com" }
  ],
  "license": "Proprietary",
  "mcp": true,
  "scopes": [
    {
      "scope": "tool:browser:crawl",
      "description": "Navigate the shared browser session and read page content/structure — no credentials submitted."
    },
    {
      "scope": "tool:browser:login",
      "description": "Open a login window for a crawl run and confirm the login (the person logs in on the site itself; no password is ever stored), and see or forget a saved login session (sealed cookies of one site, kept only when the person chose to)."
    }
  ],
  "file_sources": [
    { "id": "crawl-logs", "dir": "logs", "scope": "tool:browser:crawl" }
  ],
  "routes": [
    {
      "method": "POST",
      "path_suffix": "crawl",
      "required_scope": "tool:browser:crawl"
    },
    {
      "method": "POST",
      "path_suffix": "find-login-elements",
      "required_scope": "tool:browser:crawl"
    },
    {
      "method": "POST",
      "path_suffix": "extract",
      "required_scope": "tool:browser:crawl"
    },
    {
      "method": "POST",
      "path_suffix": "login-window/open",
      "required_scope": "tool:browser:login"
    },
    {
      "method": "GET",
      "path_suffix": "login-window/status",
      "required_scope": "tool:browser:login"
    },
    {
      "method": "POST",
      "path_suffix": "login-window/confirm",
      "required_scope": "tool:browser:login"
    },
    {
      "method": "POST",
      "path_suffix": "login-window/cancel",
      "required_scope": "tool:browser:login"
    },
    {
      "method": "PUT",
      "path_suffix": "conversation-engine",
      "required_scope": "tool:browser:crawl"
    },
    {
      "method": "GET",
      "path_suffix": "login-session/state",
      "required_scope": "tool:browser:login"
    },
    {
      "method": "DELETE",
      "path_suffix": "login-session",
      "required_scope": "tool:browser:login"
    },
    {
      "method": "POST",
      "path_suffix": "crawl-paginated",
      "required_scope": "tool:browser:crawl"
    },
    {
      "method": "POST",
      "path_suffix": "find-repeating-items",
      "required_scope": "tool:browser:crawl"
    },
    {
      "method": "POST",
      "path_suffix": "fetch-links",
      "required_scope": "tool:browser:crawl"
    },
    {
      "method": "GET",
      "path_suffix": "katana-window-hosts",
      "required_scope": "tool:browser:crawl"
    },
    {
      "method": "DELETE",
      "path_suffix": "katana-window-host",
      "required_scope": "tool:browser:crawl"
    },
    {
      "method": "POST",
      "path_suffix": "katana-window-open",
      "required_scope": "tool:browser:crawl"
    },
    {
      "method": "POST",
      "path_suffix": "katana-window-cleared",
      "required_scope": "tool:browser:crawl"
    },
    {
      "method": "POST",
      "path_suffix": "fetch-detail-candidates",
      "required_scope": "tool:browser:crawl"
    },
    {
      "method": "GET",
      "path_suffix": "capabilities",
      "required_scope": "tool:browser:crawl"
    },
    {
      "method": "GET",
      "path_suffix": "diagnose-url",
      "required_scope": "tool:browser:crawl"
    },
    {
      "method": "GET",
      "path_suffix": "domains",
      "required_scope": "tool:browser:crawl"
    },
    {
      "method": "DELETE",
      "path_suffix": "domains",
      "required_scope": "tool:browser:crawl"
    },
    {
      "method": "POST",
      "path_suffix": "domains/clear",
      "required_scope": "tool:browser:crawl"
    },
    {
      "method": "GET",
      "path_suffix": "crawl-logs",
      "required_scope": "tool:browser:crawl"
    },
    {
      "method": "DELETE",
      "path_suffix": "crawl-logs",
      "required_scope": "tool:browser:crawl"
    },
    {
      "method": "GET",
      "path_suffix": "browser-settings",
      "required_scope": "tool:browser:crawl"
    },
    {
      "method": "PUT",
      "path_suffix": "browser-settings",
      "required_scope": "tool:browser:crawl"
    },
    {
      "method": "GET",
      "path_suffix": "engine-status",
      "required_scope": "tool:browser:crawl"
    },
    {
      "method": "GET",
      "path_suffix": "chrome-status",
      "required_scope": "tool:browser:crawl"
    },
    {
      "method": "GET",
      "path_suffix": "chrome-processes",
      "required_scope": "tool:browser:crawl"
    },
    {
      "method": "POST",
      "path_suffix": "engine-test",
      "required_scope": "tool:browser:crawl"
