{
  "slug": "pdf_generator",
  "name": "PDF Generator",
  "version": "0.2.0",
  "mcp": true,
  "scopes": [
    {"scope": "tool:pdf_generator:generate", "description": "Render XHTML into a PDF."},
    {"scope": "tool:pdf_generator:read", "description": "Fetch a previously generated PDF."}
  ],
  "routes": [
    {"method": "POST", "path_suffix": "generate", "required_scope": "tool:pdf_generator:generate"},
    {"method": "GET", "path_suffix": "files", "required_scope": "tool:pdf_generator:read"}
  ]
}
