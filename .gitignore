# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
.idea/
.vscode/

# Claude
.claude/settings.local.json

# Plan

plan/

# Runtime / local dev artifacts (backend)
/api/data/
/api/server.pid
/api/*.log
/api/vendor/
/api/bin/
/api/cmd/app/webapp/dist/

# Build output (make build/build-linux) — compiled binaries, not source.
# Was an unaddressed gap before this ever produced a real file in this
# repo (build/build-linux hadn't been run here yet either).
/versions/

# Build output (make build-app). Only the compiled binary is ignored —
# app/VERSION is deliberately NOT ignored, same as api/VERSION: it's the
# persistent version counter, meant to survive across clones/commits so
# "the latest version was X" is a real, checked-in fact, not something
# that resets to 0.0.000 the moment someone clones fresh.
/app/cinqo-app

# MCP logs

.playwright-mcp