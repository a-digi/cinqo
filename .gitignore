# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# A bare `go build ./...` (no -o) inside a tool's own backend/
# directory drops a binary named after that module right there —
# e.g. tools/browser/backend/browser-tool-backend. Not a real "build"
# output path (that's already covered by /tools/*/build/ below), just
# stray local verification debris; excluded broadly rather than
# per-tool so this can't recur for any tool's own backend module.
/tools/*/backend/*-backend

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
.idea/
.vscode/

# Claude
.claude/settings.local.json

# Plan

plan/

# Runtime / local dev artifacts (backend)
/api/data/
/api/server.pid
/api/*.log
/api/vendor/
/api/bin/
/api/cmd/app/webapp/dist/

# Build output (make build/build-linux) — compiled binaries, not source.
# Was an unaddressed gap before this ever produced a real file in this
# repo (build/build-linux hadn't been run here yet either).
/versions/

# Build output (make build-app). Only the compiled binary is ignored —
# app/VERSION is deliberately NOT ignored, same as api/VERSION: it's the
# persistent version counter, meant to survive across clones/commits so
# "the latest version was X" is a real, checked-in fact, not something
# that resets to 0.0.000 the moment someone clones fresh.
/app/cinqo-app

# Every tool's own build output (make package-tool's generic build,
# and any tool-specific Makefile's own per-OS builds) — a build
# artifact, not source; the source lives in tools/<name>/ itself,
# tracked. Final installable .zips still land in /versions/ for a
# tool using the generic package-tool path.
/tools/*/build/

# A tool with its own multi-OS Makefile (e.g. pdf_generator) drops its
# finished .zips inside its own folder instead of the shared
# /versions/ — still a build artifact, not source.
/tools/*/versions/

# Step 15 (browser tool): frontend/bundle.js is now generated by
# frontend-app/'s own React+Tailwind build (tracked source), not
# hand-written — same "build artifact, not source" treatment as
# app/cinqo-app and frontend/dist elsewhere in this repo.
/tools/browser/frontend/bundle.js
/tools/browser/frontend-app/node_modules/
/tools/browser/frontend-app/dist/

# Step 5 (career tool): same treatment, same reason.
/tools/career/frontend/bundle.js
/tools/career/frontend-app/node_modules/
/tools/career/frontend-app/dist/

# MCP logs

.playwright-mcp
*.pid